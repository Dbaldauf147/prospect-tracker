rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Access control helpers ---------------------------------------
    // Keep this domain list in sync with VITE_ALLOWED_EMAIL_DOMAINS (client)
    // and ALLOWED_EMAIL_DOMAINS (server). Firestore rules can't read env
    // vars, so the allowlist is encoded here and must be edited on deploy.
    function isAdmin() {
      return request.auth != null && request.auth.token.email == "baldaufdan@gmail.com";
    }
    function allowedDomains() {
      // EDIT ME: the email domains permitted to use the app.
      return ["example.com"];
    }
    function emailDomain() {
      return request.auth.token.email.split("@")[1];
    }
    // An authorized caller: signed in AND either the admin or on an
    // allowed domain. Verified-email requirement keeps spoofed custom
    // tokens out (Google/password sign-in both set email_verified).
    function isAuthorized() {
      return request.auth != null
        && (isAdmin() || emailDomain() in allowedDomains());
    }

    // Shared prospects collection: only the admin account. Other authorized
    // users use their per-user collection at /users/{uid}/prospects.
    match /prospects/{prospectId} {
      allow read, write: if isAdmin();
    }

    // True when the caller owns this document path AND is authorized.
    function owns(userId) {
      return isAuthorized() && request.auth.uid == userId;
    }

    // Indicative Savings analyses saved against a prospect from the
    // Utility Lookup page. Lives in a subcollection so the bulk
    // /prospects query doesn't have to fetch the base64 XLSX blob.
    match /prospects/{prospectId}/analyses/{analysisId} {
      allow read, write: if isAdmin();
    }

    // Users collection: users can only read/write their own document
    match /users/{userId} {
      allow read, write: if owns(userId);
    }

    // Per-user prospects: users can only access their own prospects
    match /users/{userId}/prospects/{prospectId} {
      allow read, write: if owns(userId);
    }

    // Per-user analyses subcollection (Indicative Savings blobs).
    match /users/{userId}/prospects/{prospectId}/analyses/{analysisId} {
      allow read, write: if owns(userId);
    }

    // Per-user uploaded list backups (legacy path). Kept readable so
    // listBackupSync can fall back to a user's existing backup when the
    // shared listBackups doc is missing — this is how the admin's
    // existing lists get promoted into the shared collection without a
    // manual migration step.
    match /users/{userId}/listBackups/{storageKey} {
      allow read, write: if owns(userId);
    }

    // Shared uploaded list backups. The Lists tab is the same canonical
    // set of rows for every signed-in user (see CLAUDE.md). Authorized
    // users may READ it, but only the admin may WRITE — otherwise any
    // user re-uploading or clearing a list would clobber the shared
    // store for everyone.
    match /listBackups/{storageKey} {
      allow read: if isAuthorized();
      allow write: if isAdmin();
    }

    // Per-user integration OAuth tokens (HubSpot/Google/Microsoft) are
    // written and read ONLY by the server (firebase-admin bypasses
    // rules). Clients must never touch them.
    match /integrationTokens/{userId} {
      allow read, write: if false;
    }

    // Per-user API rate-limit counters — server-only.
    match /rateLimits/{docId} {
      allow read, write: if false;
    }

    // User settings: users can only read/write their own settings
    match /userSettings/{userId} {
      allow read, write: if owns(userId);
    }

    // Target accounts: users can only read/write their own data
    match /targetAccounts/{userId} {
      allow read, write: if owns(userId);
    }

    // Opps data: users can only read/write their own data
    match /oppsData/{userId} {
      allow read, write: if owns(userId);
    }

    // Opps 2 data: user-entered opps from the Opps 2 tab. Same per-user
    // scoping as oppsData.
    match /opps2Data/{userId} {
      allow read, write: if owns(userId);
    }

    // Opps 2 payload chunks: the JSON blob is split across this
    // subcollection so the dataset can grow past Firestore's 1 MB
    // per-document cap.
    match /opps2Data/{userId}/chunks/{chunkId} {
      allow read, write: if owns(userId);
    }

    // Email campaigns: users can only read/write their own data
    match /emailCampaigns/{userId} {
      allow read, write: if owns(userId);
    }

    // Progress history: users can only read/write their own data
    match /progressHistory/{userId} {
      allow read, write: if owns(userId);
    }

    // PE Opps email schedules: each doc is a recurring email owned by one
    // user (ownerUid). The owner may read/write/delete their own; the
    // hourly cron reads them with the admin SDK (which bypasses rules).
    // A user may only create/own docs stamped with their own uid.
    match /peOppsEmailSchedules/{scheduleId} {
      allow read, delete: if isAuthorized() && resource.data.ownerUid == request.auth.uid;
      allow create: if isAuthorized() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAuthorized()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;
    }

    // Audit log: append-only. Authenticated users may create entries
    // stamped with their own uid. No read/update/delete from the client;
    // admin inspection goes through Firebase Console.
    match /auditLog/{docId} {
      allow create: if isAuthorized() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if false;
    }

    // Default deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
