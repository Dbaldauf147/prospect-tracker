rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Access control helpers ---------------------------------------
    function isAdmin() {
      return request.auth != null && request.auth.token.email == "baldaufdan@gmail.com";
    }
    // Registration is open: any signed-in user is authorized and gets
    // their own isolated workspace (per-user collections below). The
    // shared prospects/lists collections remain admin-only for writes.
    // To re-restrict sign-up to specific domains, reintroduce a domain
    // check here (and keep it in sync with the client allowlist).
    function isAuthorized() {
      return request.auth != null;
    }

    // Shared prospects collection: only the admin account. Other authorized
    // users use their per-user collection at /users/{uid}/prospects.
    match /prospects/{prospectId} {
      allow read, write: if isAdmin();
    }

    // True when the caller owns this document path AND is authorized.
    function owns(userId) {
      return isAuthorized() && request.auth.uid == userId;
    }

    // Indicative Savings analyses saved against a prospect from the
    // Utility Lookup page. Lives in a subcollection so the bulk
    // /prospects query doesn't have to fetch the base64 XLSX blob.
    match /prospects/{prospectId}/analyses/{analysisId} {
      allow read, write: if isAdmin();
    }

    // Users collection: users can only read/write their own document
    match /users/{userId} {
      allow read, write: if owns(userId);
    }

    // Per-user prospects: users can only access their own prospects
    match /users/{userId}/prospects/{prospectId} {
      allow read, write: if owns(userId);
    }

    // Per-user analyses subcollection (Indicative Savings blobs).
    match /users/{userId}/prospects/{prospectId}/analyses/{analysisId} {
      allow read, write: if owns(userId);
    }

    // Per-user uploaded list backups (legacy path). Kept readable so
    // listBackupSync can fall back to a user's existing backup when the
    // shared listBackups doc is missing — this is how the admin's
    // existing lists get promoted into the shared collection without a
    // manual migration step.
    match /users/{userId}/listBackups/{storageKey} {
      allow read, write: if owns(userId);
    }

    // Shared uploaded list backups. The Lists tab is the same canonical
    // set of rows for every signed-in user (see CLAUDE.md). Authorized
    // users may READ it, but only the admin may WRITE — otherwise any
    // user re-uploading or clearing a list would clobber the shared
    // store for everyone.
    match /listBackups/{storageKey} {
      allow read: if isAuthorized();
      allow write: if isAdmin();
    }

    // Shared compliance-mandate corrections. The building-compliance
    // screening runs off a committed seed built from a workbook; when a
    // jurisdiction moves a deadline or publishes a penalty the sheet
    // never carried, the correction is typed on the page and lands here.
    // It is reference data about a city's ordinance, not anybody's own
    // record, so every signed-in user reads AND writes it — a correction
    // that only reached the person who made it would leave the rest of
    // the team screening against the figure they already know is wrong.
    // Each write stamps updatedBy, so a wrong correction can be traced
    // and reverted. Tighten to isAdmin() for write if that trade stops
    // being the right one.
    match /complianceOrdinances/{govKey} {
      allow read, write: if isAuthorized();
    }

    // Per-user integration OAuth tokens (HubSpot/Google/Microsoft) are
    // written and read ONLY by the server (firebase-admin bypasses
    // rules). Clients must never touch them.
    match /integrationTokens/{userId} {
      allow read, write: if false;
    }

    // Per-user API rate-limit counters — server-only.
    match /rateLimits/{docId} {
      allow read, write: if false;
    }

    // Email open/click tracking. Docs are created and updated ONLY by
    // the server (firebase-admin bypasses rules) — the open pixel and
    // click redirector are unauthenticated public endpoints, so clients
    // must never be able to forge or tamper with tracking data. The
    // owner (and admin) may read their own tracking records for the
    // Email Tracking dashboard.
    match /emailTracking/{trackingId} {
      allow read: if isAdmin() || (isAuthorized() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    // User settings: users can only read/write their own settings
    match /userSettings/{userId} {
      allow read, write: if owns(userId);
    }

    // Per-company site lists. One document per company rather than a
    // `companySiteLists` map on the settings document: each list is a
    // whole spreadsheet, and together they filled the 1 MB cap, at which
    // point every settings write started failing.
    match /userSettings/{userId}/companySiteLists/{companySlug} {
      allow read, write: if owns(userId);
    }

    // Firestore mirror of the localStorage-backed stores — the uploaded
    // deals roster, the deal→client mappings, and the typed Clients-tab
    // fields. These lived in one browser and nowhere else, so clearing site
    // data lost them (and left the Issues tab reporting every client as
    // missing a contract End Date). One document per localStorage key.
    match /userSettings/{userId}/localMirrors/{mirrorKey} {
      allow read, write: if owns(userId);
    }

    // Payload chunks for a mirrored key too large for one document, split
    // the same way opps2Data/chunks is.
    match /userSettings/{userId}/localMirrors/{mirrorKey}/chunks/{chunkId} {
      allow read, write: if owns(userId);
    }

    // Google Sheets auto-sync clock: when the additive import last ran for
    // this account. Its own document rather than a field on the settings
    // document because it is rewritten on every completed pass, and a
    // value that churns that often would bump the _lastWriteAt every
    // cross-device settings save is compared against.
    match /userSettings/{userId}/syncState/{stateId} {
      allow read, write: if owns(userId);
    }

    // Contract language: the wording that goes into a contract for each
    // service, typed on the Clients view's Contract Language subtab. One
    // document per service for the same reason companySiteLists split —
    // clause text is long-form prose, and a library covering the catalogue
    // would fill the settings document and take every other settings write
    // down with it.
    match /userSettings/{userId}/contractLanguage/{serviceSlug} {
      allow read, write: if owns(userId);
    }

    // Target accounts: users can only read/write their own data
    match /targetAccounts/{userId} {
      allow read, write: if owns(userId);
    }

    // Opps data: users can only read/write their own data
    match /oppsData/{userId} {
      allow read, write: if owns(userId);
    }

    // Opps 2 data: user-entered opps from the Opps 2 tab. Same per-user
    // scoping as oppsData.
    match /opps2Data/{userId} {
      allow read, write: if owns(userId);
    }

    // Opps 2 payload chunks: the JSON blob is split across this
    // subcollection so the dataset can grow past Firestore's 1 MB
    // per-document cap.
    match /opps2Data/{userId}/chunks/{chunkId} {
      allow read, write: if owns(userId);
    }

    // RFP templates attached to an Opps 2 deal from the Follow Up Notes
    // popup. One document per opp, holding the workbook as base64 split
    // across chunk fields — a whole spreadsheet, so it can't share a
    // document with the opps payload without threatening the 1 MB cap.
    // Same per-user scoping as the opps data it hangs off.
    match /oppRfpTemplates/{userId} {
      allow read, write: if owns(userId);
    }
    match /oppRfpTemplates/{userId}/items/{oppId} {
      allow read, write: if owns(userId);
    }

    // Email campaigns: users can only read/write their own data
    match /emailCampaigns/{userId} {
      allow read, write: if owns(userId);
    }

    // Call recordings: the transcript, AI summary, and company/opp tag
    // for each recording on the Call Recordings page. The media itself
    // stays in the user's OneDrive or on their PC and is never stored
    // here — only text derived from it. One document per recording (a
    // long transcript would blow the 1 MB cap if they shared one), so
    // the parent doc is a container and the items live beneath it.
    match /callRecordings/{userId} {
      allow read, write: if owns(userId);
    }
    match /callRecordings/{userId}/items/{recordingId} {
      allow read, write: if owns(userId);
    }

    // Progress history: users can only read/write their own data
    match /progressHistory/{userId} {
      allow read, write: if owns(userId);
    }

    // Weekly reviews: the recorded "what's holding me back" verdict for each
    // week, written by the Weekly Report tab. Same per-user scoping as
    // progressHistory — one document per user holding a `weeks` array.
    match /weeklyReviews/{userId} {
      allow read, write: if owns(userId);
    }

    // PE Opps email schedules (peOppsEmailSchedules), New Opps email
    // schedules (newOppsEmailSchedules) and acquisition-news email schedules
    // (companyNewsEmailSchedules) are read/written ONLY by the server: the
    // authenticated CRUD routes (api/pe-opps-schedules,
    // api/new-opps-schedules, api/company-news-schedules) and the hourly
    // crons (api/pe-opps-scheduler, api/new-opps-scheduler,
    // api/company-news-scheduler) all use the admin SDK, which bypasses
    // these rules. Clients never touch the collections directly, so they
    // stay default-deny here.

    // Backup run metadata (counts / last-file / anomaly flags) written by
    // the daily-backup cron and the on-demand backup route via the admin
    // SDK. Never read or written by the client — explicit default-deny so
    // backup history (and the counts it exposes) can't be probed.
    match /backupRuns/{userId} {
      allow read, write: if false;
    }

    // Audit log: append-only. Authenticated users may create entries
    // stamped with their own uid. No read/update/delete from the client;
    // admin inspection goes through Firebase Console.
    match /auditLog/{docId} {
      allow create: if isAuthorized() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if false;
    }

    // Default deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
