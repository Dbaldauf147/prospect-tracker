# ---------------------------------------------------------------------------
# Prospect Tracker — environment variables
#
# Copy this file to `.env` (gitignored) for local dev, and set the same keys
# in your Vercel project settings for production. Variables prefixed with
# VITE_ are exposed to the browser bundle; everything else is server-only.
# ---------------------------------------------------------------------------

# === Access control (multi-user) ==========================================
# Comma-separated list of email domains allowed to sign in / register.
# The client (VITE_) and the server value MUST match, and both MUST match
# the allowedDomains() list in firestore.rules. Leave empty to fail closed
# (only the admin email can sign in).
VITE_ALLOWED_EMAIL_DOMAINS=example.com,acme.com
ALLOWED_EMAIL_DOMAINS=example.com,acme.com

# === Firebase (client) =====================================================
# From Firebase console > Project settings > Your apps > SDK config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# === Firebase Admin (server) ===============================================
# Service-account JSON used to verify caller ID tokens on every API route.
# Paste the JSON on one line, or base64-encode it. Generate one at
# Firebase console > Project settings > Service accounts > Generate new key.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Separate service-account credential used only by the Power Automate
# calendar webhook (api/calendar-webhook.js). May be the same value as
# FIREBASE_SERVICE_ACCOUNT_KEY.
FIREBASE_SERVICE_ACCOUNT=

# === API origin / CORS =====================================================
# Production URL of the deployed app. API routes only accept cross-origin
# requests from this origin. e.g. https://prospect-tracker.vercel.app
APP_ORIGIN=

# Origin used to build email open-pixel / click-redirect links. Leave
# blank to reuse APP_ORIGIN (the default). Set only if you want tracking
# links served from a different domain than the app.
TRACKING_BASE_URL=

# === Shared, auth-gated third-party keys ===================================
# These remain a single shared credential; API routes require a verified
# signed-in user and apply per-user rate limiting before using them.
ANTHROPIC_API_KEY=
APOLLO_API_KEY=
HUBSPOT_ACCESS_TOKEN=
RESEND_API_KEY=

# Gmail SMTP for the scheduled PE Opps email digest. Uses a Gmail account
# plus an App Password so the file can be emailed to any recipient for free
# (no paid sending domain). To create the App Password: enable 2-Step
# Verification on the Google account, then visit
# https://myaccount.google.com/apppasswords and generate one. Paste the
# 16-character code (spaces optional) as GMAIL_APP_PASSWORD.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional display name shown as the sender. Defaults to "Prospect Tracker".
GMAIL_FROM_NAME=

# Secret shared with Vercel Cron. When set, the PE Opps scheduler
# (api/pe-opps-scheduler.js) rejects any request whose
# Authorization: Bearer <token> doesn't match. Vercel attaches this
# header automatically to cron invocations when CRON_SECRET is set.
CRON_SECRET=

# Google Sheets sync service-account JSON (one line or base64).
GOOGLE_SERVICE_ACCOUNT_KEY=

# === Microsoft / Outlook OAuth =============================================
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_REDIRECT_URI=
